@model MoCashRoCo.ViewModels.ProductFormViewModel
@{
    ViewData["Title"] = "Add Product";
}

<div class="admin-wrap">

  <aside class="admin-sidebar">
    <div class="admin-brand">
      <i class="bi bi-shield-lock-fill me-2"></i>Admin Portal
    </div>
    <nav class="admin-nav">
      <a href="@Url.Action("Dashboard","Admin")" class="admin-nav-link">
        <i class="bi bi-speedometer2"></i> Dashboard
      </a>
      <a href="@Url.Action("Products","Admin")" class="admin-nav-link active">
        <i class="bi bi-box-seam"></i> Products
      </a>
      <a href="@Url.Action("Orders","Admin")" class="admin-nav-link">
        <i class="bi bi-receipt"></i> Orders
      </a>
      <hr class="border-secondary opacity-25 my-2" />
      <a href="@Url.Action("Index","Home")" class="admin-nav-link text-secondary">
        <i class="bi bi-arrow-left"></i> Back to Store
      </a>
    </nav>
  </aside>

  <main class="admin-main">
    <div class="admin-topbar">
      <div>
        <a href="@Url.Action("Products","Admin")" class="text-secondary text-decoration-none small">
          <i class="bi bi-chevron-left"></i> Products
        </a>
        <h4 class="mb-0 fw-bold mt-1">Add Product</h4>
      </div>
    </div>

    <div class="admin-card" style="max-width:700px;">
      <form asp-action="CreateProduct" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

        <div class="row g-3">
          <div class="col-12">
            <label asp-for="Name" class="form-label fw-semibold small text-secondary text-uppercase">Product Name</label>
            <input asp-for="Name" class="form-control admin-input" placeholder="e.g. Wireless Headphones" />
            <span asp-validation-for="Name" class="text-danger small"></span>
          </div>

          <div class="col-md-6">
            <label asp-for="Price" class="form-label fw-semibold small text-secondary text-uppercase">Price ($)</label>
            <input asp-for="Price" class="form-control admin-input" placeholder="0.00" />
            <span asp-validation-for="Price" class="text-danger small"></span>
          </div>

          <div class="col-md-6">
            <label asp-for="CategoryId" class="form-label fw-semibold small text-secondary text-uppercase">Category</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select admin-input">
              <option value="">-- Select category --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger small"></span>
          </div>

          <div class="col-md-6">
            <label asp-for="StockQuantity" class="form-label fw-semibold small text-secondary text-uppercase">Stock Quantity</label>
            <input asp-for="StockQuantity" class="form-control admin-input" placeholder="0" />
            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
          </div>

          <div class="col-md-6 d-flex align-items-end">
            <div class="form-check form-switch mb-2">
              <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
              <label asp-for="IsActive" class="form-check-label">Active (visible in store)</label>
            </div>
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold small text-secondary text-uppercase">Product Image</label>
            <input asp-for="ImageFile" type="file" accept="image/*" class="form-control admin-input" id="imageFileInput" />
            <div class="mt-2 text-secondary small">or paste a URL below</div>
            <input asp-for="ImageUrl" class="form-control admin-input mt-1" placeholder="https://..." id="imageUrlInput" />
            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            <div class="mt-2" id="imagePreview" style="display:none;">
              <img id="previewImg" src="" alt="Preview"
                   style="max-width:200px;max-height:150px;object-fit:cover;border-radius:8px;border:1px solid #444;" />
            </div>
          </div>

          <div class="col-12">
            <label asp-for="Description" class="form-label fw-semibold small text-secondary text-uppercase">Description</label>
            <textarea asp-for="Description" class="form-control admin-input" rows="4"
                      placeholder="Describe the product..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
          </div>
        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="submit" class="btn btn-success px-4">
            <i class="bi bi-plus-circle me-1"></i>Create Product
          </button>
          <a href="@Url.Action("Products","Admin")" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</div>

@section Scripts {
<script>
  document.getElementById('imageFileInput')?.addEventListener('change', function () {
    var file = this.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function (e) {
      document.getElementById('previewImg').src = e.target.result;
      document.getElementById('imagePreview').style.display = 'block';
    };
    reader.readAsDataURL(file);
  });
  document.getElementById('imageUrlInput')?.addEventListener('input', function () {
    if (document.getElementById('imageFileInput').files.length > 0) return;
    var preview = document.getElementById('imagePreview');
    var img = document.getElementById('previewImg');
    if (this.value.startsWith('http')) {
      img.src = this.value;
      preview.style.display = 'block';
    } else {
      preview.style.display = 'none';
    }
  });
</script>
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
