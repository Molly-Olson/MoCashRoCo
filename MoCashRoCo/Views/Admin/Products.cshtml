@model List<MoCashRoCo.Models.Product>
@using MoCashRoCo.Models
@{
    ViewData["Title"] = "Manage Products";
    var categories = ViewBag.Categories as List<Category>;
}

<div class="admin-wrap">

  <aside class="admin-sidebar">
    <div class="admin-brand">
      <i class="bi bi-shield-lock-fill me-2"></i>Admin Portal
    </div>
    <nav class="admin-nav">
      <a href="@Url.Action("Dashboard","Admin")" class="admin-nav-link">
        <i class="bi bi-speedometer2"></i> Dashboard
      </a>
      <a href="@Url.Action("Products","Admin")" class="admin-nav-link active">
        <i class="bi bi-box-seam"></i> Products
      </a>
      <a href="@Url.Action("Orders","Admin")" class="admin-nav-link">
        <i class="bi bi-receipt"></i> Orders
      </a>
      <hr class="border-secondary opacity-25 my-2" />
      <a href="@Url.Action("Index","Home")" class="admin-nav-link text-secondary">
        <i class="bi bi-arrow-left"></i> Back to Store
      </a>
    </nav>
  </aside>

  <main class="admin-main">
    <div class="admin-topbar">
      <h4 class="mb-0 fw-bold">Products</h4>
      <a href="@Url.Action("CreateProduct","Admin")" class="btn btn-success btn-sm px-3">
        <i class="bi bi-plus-circle me-1"></i>Add Product
      </a>
    </div>

    @if (TempData["Success"] != null)
    {
      <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    }
    @if (TempData["Info"] != null)
    {
      <div class="alert alert-info alert-dismissible fade show">
        <i class="bi bi-info-circle me-2"></i>@TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    }

    <!-- Filters -->
    <form method="get" class="d-flex gap-2 mb-3 flex-wrap">
      <input name="search" value="@ViewBag.Search" class="form-control form-control-sm admin-input"
             placeholder="Search products..." style="max-width:240px;" />
      <select name="categoryId" class="form-select form-select-sm admin-input" style="max-width:180px;">
        <option value="">All Categories</option>
        @if (categories != null)
        {
          foreach (var cat in categories)
          {
            if (ViewBag.CategoryId?.ToString() == cat.CategoryId.ToString())
            {
              <option value="@cat.CategoryId" selected>@cat.Name</option>
            }
            else
            {
              <option value="@cat.CategoryId">@cat.Name</option>
            }
          }
        }
      </select>
      <button type="submit" class="btn btn-outline-secondary btn-sm px-3">Filter</button>
      <a href="@Url.Action("Products","Admin")" class="btn btn-link btn-sm text-secondary">Clear</a>
    </form>

    <div class="admin-card">
      <div class="table-responsive">
        <table class="table table-dark table-hover mb-0 admin-table">
          <thead>
            <tr>
              <th style="width:60px;">Image</th>
              <th>Name</th>
              <th>Category</th>
              <th>Price</th>
              <th>Stock</th>
              <th>Status</th>
              <th style="width:150px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var product in Model)
            {
              <tr class="@(!product.IsActive ? "opacity-50" : "")">
                <td>
                  @if (!string.IsNullOrEmpty(product.ImageUrl))
                  {
                    <img src="@product.ImageUrl" alt="@product.Name"
                         style="width:44px;height:44px;object-fit:cover;border-radius:6px;" />
                  }
                  else
                  {
                    <div style="width:44px;height:44px;background:var(--bs-gray-700);border-radius:6px;
                                display:flex;align-items:center;justify-content:center;">
                      <i class="bi bi-image text-secondary"></i>
                    </div>
                  }
                </td>
                <td>
                  <div class="fw-semibold">@product.Name</div>
                  @if (!string.IsNullOrEmpty(product.Description))
                  {
                    <div class="text-secondary small">
                      @(product.Description.Length > 60
                        ? product.Description.Substring(0, 60) + "…"
                        : product.Description)
                    </div>
                  }
                </td>
                <td class="text-secondary">@product.Category?.Name</td>
                <td>@product.Price.ToString("C")</td>
                <td>
                  @if (product.StockQuantity < 10)
                  {
                    <span class="badge bg-warning text-dark">@product.StockQuantity low</span>
                  }
                  else
                  {
                    <span>@product.StockQuantity</span>
                  }
                </td>
                <td>
                  @if (product.IsActive)
                  {
                    <span class="badge bg-success">Active</span>
                  }
                  else
                  {
                    <span class="badge bg-secondary">Inactive</span>
                  }
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <a href="@Url.Action("EditProduct","Admin",new{id=product.ProductId})"
                       class="btn btn-outline-primary btn-sm px-2" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form asp-action="DeleteProduct" asp-controller="Admin"
                          method="post" class="d-inline"
                          onsubmit="return confirm('Delete @Html.Raw(product.Name.Replace("'","\\'")??"product")?')">
                      <input type="hidden" name="id" value="@product.ProductId" />
                      @Html.AntiForgeryToken()
                      <button type="submit" class="btn btn-outline-danger btn-sm px-2" title="Delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            }
            @if (!Model.Any())
            {
              <tr><td colspan="7" class="text-center text-secondary py-5">No products found.</td></tr>
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="text-secondary small mt-2">@Model.Count product(s) shown</div>
  </main>
</div>
