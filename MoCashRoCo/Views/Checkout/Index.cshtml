@model MoCashRoCo.Models.CheckoutViewModel
@{ ViewData["Title"] = "Checkout"; }

<div class="container py-5">
    <div class="d-flex align-items-center gap-3 mb-4">
        <h1 class="fw-bold mb-0">Checkout</h1>
        <span class="badge bg-brand-soft text-brand">@Model.CartItems.Count item@(Model.CartItems.Count != 1 ? "s" : "")</span>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mb-4">
            <div asp-validation-summary="All" class="mb-0"></div>
        </div>
    }

    <div class="row g-5">

        <!-- ── Left: Form ─────────────────────────────────────────── -->
        <div class="col-lg-7">
            <form asp-action="Index" method="post" id="checkoutForm">

                <!-- Contact -->
                <div class="card border-0 shadow-sm rounded-xl mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3"><i class="bi bi-person-lines-fill me-2 text-brand"></i>Contact Info</h5>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label fw-semibold small">Full Name</label>
                                <input asp-for="Name" class="form-control" placeholder="Jane Smith" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-7">
                                <label asp-for="Email" class="form-label fw-semibold small">Email</label>
                                <input asp-for="Email" class="form-control" placeholder="jane@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="Phone" class="form-label fw-semibold small">Phone</label>
                                <input asp-for="Phone" class="form-control" placeholder="(555) 000-0000" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Shipping -->
                <div class="card border-0 shadow-sm rounded-xl mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3"><i class="bi bi-truck me-2 text-brand"></i>Shipping Address</h5>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-semibold small">Street Address</label>
                                <input asp-for="Address" class="form-control" placeholder="123 Main St" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="City" class="form-label fw-semibold small">City</label>
                                <input asp-for="City" class="form-control" placeholder="Springfield" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="State" class="form-label fw-semibold small">State</label>
                                <input asp-for="State" class="form-control" placeholder="IL" maxlength="2" />
                                <span asp-validation-for="State" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Zip" class="form-label fw-semibold small">ZIP Code</label>
                                <input asp-for="Zip" class="form-control" placeholder="62701" />
                                <span asp-validation-for="Zip" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Notes -->
                <div class="card border-0 shadow-sm rounded-xl mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3"><i class="bi bi-chat-text me-2 text-brand"></i>Order Notes</h5>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                            placeholder="Special instructions, delivery preferences, gift message..."></textarea>
                    </div>
                </div>

                <!-- Payment (simulated) -->
                <div class="card border-0 shadow-sm rounded-xl mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3"><i class="bi bi-credit-card me-2 text-brand"></i>Payment</h5>
                        <div class="alert alert-info mb-3 py-2 small">
                            <i class="bi bi-info-circle me-2"></i>Payment is simulated for this demo — no real charges.
                        </div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Card Number</label>
                                <input type="text" class="form-control" value="4242 4242 4242 4242" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Expiry</label>
                                <input type="text" class="form-control" value="12/28" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">CVC</label>
                                <input type="text" class="form-control" value="123" readonly />
                            </div>
                        </div>
                    </div>
                </div>

            </form>
        </div>

        <!-- ── Right: Order Summary ──────────────────────────────── -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-xl sticky-top" style="top:80px">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-bag-check me-2 text-brand"></i>Order Summary</h5>

                    @foreach (var item in Model.CartItems)
                    {
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <img src="@(item.ImageUrl ?? "https://picsum.photos/seed/default/60/60")"
                                 class="rounded" width="52" height="52" style="object-fit:cover" alt="@item.Name" />
                            <div class="flex-grow-1 min-width-0">
                                <div class="fw-semibold small line-clamp-2">@item.Name</div>
                                <div class="text-muted small">Qty: @item.Quantity</div>
                            </div>
                            <div class="fw-bold small text-nowrap">$@((item.Price * item.Quantity).ToString("F2"))</div>
                        </div>
                    }

                    <hr class="my-3" />

                    <div class="d-flex justify-content-between small mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span>$@Model.Subtotal.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between small mb-3">
                        <span class="text-muted">Shipping</span>
                        @if (Model.Shipping == 0)
                        {
                            <span class="text-success fw-semibold">FREE</span>
                        }
                        else
                        {
                            <span>$@Model.Shipping.ToString("F2")</span>
                        }
                    </div>
                    @if (Model.Shipping > 0)
                    {
                        <div class="alert alert-light py-2 small mb-3">
                            <i class="bi bi-truck me-1"></i>Add $@((50 - Model.Subtotal).ToString("F2")) more for free shipping!
                        </div>
                    }
                    <hr class="my-3" />
                    <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                        <span>Total</span>
                        <span class="text-brand">$@Model.Total.ToString("F2")</span>
                    </div>

                    <button type="submit" form="checkoutForm" class="btn btn-brand w-100 py-3 fw-bold fs-5 rounded-pill">
                        <i class="bi bi-lock-fill me-2"></i>Place Order
                    </button>

                    <div class="d-flex justify-content-center gap-3 mt-3">
                        <small class="text-muted"><i class="bi bi-shield-check me-1"></i>Secure</small>
                        <small class="text-muted"><i class="bi bi-arrow-return-left me-1"></i>30-day returns</small>
                    </div>

                    <div class="mt-3 text-center">
                        <a asp-controller="Cart" asp-action="Index" class="text-muted small text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>Back to cart
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
